<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PatchSentinel.Core</RootNamespace>
    <AssemblyName>PatchSentinel.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\rules\eol-rules.json" LogicalName="PatchSentinel.Core.eol-rules.json" Link="Rules\eol-rules.json" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="DefaultRulesUrl" Value="$(DefaultRulesUrl)" />
    <AssemblyMetadata Include="UpdateRepo" Value="$(UpdateRepo)" />
    <InternalsVisibleTo Include="PatchSentinel.Core.Tests" />
  </ItemGroup>

</Project>
