<Window x:Class="PatchSentinel.Tray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PatchSentinel" Height="660" Width="1080" MinHeight="500" MinWidth="860"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13" Background="#F7F7F7">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#ECECEC" Padding="12,5">
            <TextBlock x:Name="StatusBarText" Text="Connecting to the PatchSentinel agent..." Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
        </Border>

        <TabControl x:Name="Tabs" Margin="10" Background="White">
            <TabItem Header="Overview" x:Name="OverviewTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock x:Name="HeadlineText" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Text="Checking this device..."/>
                        <TextBlock x:Name="SubheadText" Margin="0,6,0,18" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                        <UniformGrid Columns="4" Margin="0,0,0,18">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="EolCount" Style="{StaticResource CardNumber}" Foreground="{StaticResource Critical}" Text="-"/>
                                    <TextBlock Text="End-of-life software" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="NearingCount" Style="{StaticResource CardNumber}" Foreground="{StaticResource Warning}" Text="-"/>
                                    <TextBlock Text="Approaching end of life" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="OutdatedCount" Style="{StaticResource CardNumber}" Foreground="{StaticResource Warning}" Text="-"/>
                                    <TextBlock Text="Runtimes missing patches" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="UpdatesCount" Style="{StaticResource CardNumber}" Foreground="{StaticResource Accent}" Text="-"/>
                                    <TextBlock Text="App updates available" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <TextBlock x:Name="ScheduleSummaryText" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <WrapPanel>
                            <Button x:Name="ScanButton" Content="Scan now" Click="ScanNow_Click" Style="{StaticResource Primary}"/>
                            <Button x:Name="UpdateAllButton" Content="Install app updates now" Click="UpdateAll_Click"/>
                            <Button x:Name="DeferButton" Content="Postpone scheduled updates 1 hour" Click="Defer_Click"/>
                            <Button x:Name="ExportButton" Content="Export report..." Click="Export_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="WarningsText" Margin="0,14,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Legacy &amp; end-of-life" x:Name="FindingsTab">
                <DockPanel Margin="10">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="This software no longer gets security fixes (or is missing patches) and will be reported by vulnerability scans. Select Fix to see which apps still use it and the safest way to remove or upgrade it."/>
                    <DataGrid x:Name="FindingsGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" ClipboardCopyMode="IncludeHeader"
                              CanUserAddRows="False" SelectionMode="Single" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E6E6E6" Background="White" BorderBrush="#E0E0E0" RowHeaderWidth="0">
                                                <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy selected rows" Click="CopyRows_Click"/>
                                <MenuItem Header="Copy software name" Click="CopyColumn_Click" Tag="Title"/>
                                <MenuItem Header="Copy installed versions" Click="CopyColumn_Click" Tag="Versions"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="80"/>
                            <DataGridTextColumn Header="Software" Binding="{Binding Title}" Width="2*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="2*"/>
                            <DataGridTextColumn Header="Installed" Binding="{Binding Versions}" Width="1.6*"/>
                            <DataGridTextColumn Header="Apps using it" Binding="{Binding Dependents}" Width="1.2*"/>
                            <DataGridTemplateColumn Header="" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Fix..." Click="Fix_Click" Tag="{Binding}" Margin="4,3" Padding="10,2" MinWidth="0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="App updates" x:Name="UpdatesTab">
                <DockPanel Margin="10">
                    <Border DockPanel.Dock="Top" x:Name="ManualBanner" Background="#FFF4E5" BorderBrush="#F0C27B" BorderThickness="1"
                            CornerRadius="6" Padding="10,6" Margin="0,0,0,10" Visibility="Collapsed">
                        <TextBlock x:Name="ManualBannerText" TextWrapping="Wrap" Foreground="{StaticResource Warning}"/>
                    </Border>
                    <CheckBox DockPanel.Dock="Top" x:Name="ShowWindowsManaged" Margin="0,0,0,8" Click="ShowWindowsManaged_Click"
                              Content="Show framework and Store packages that Windows updates itself"/>
                    <TextBlock DockPanel.Dock="Top" x:Name="UpdatesIntro" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Updates found by winget. Tick Update and choose Install ticked, or tick Exclude for apps that must never be updated automatically, then Save exclusions."/>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button Content="Check for updates" Click="ScanNow_Click"/>
                        <Button x:Name="InstallSelectedButton" Content="Install ticked" Click="InstallSelected_Click"/>
                        <Button Content="Install all (except excluded)" Click="UpdateAll_Click" Style="{StaticResource Primary}"/>
                        <Button x:Name="SaveExclusionsButton" Content="Save exclusions" Click="SaveExclusions_Click"/>
                        <Button x:Name="UserUpdatesButton" Content="Update my per-user apps" Click="UserUpdates_Click"
                                ToolTip="Runs winget in your own account for apps installed only for you"/>
                    </WrapPanel>
                    <Expander DockPanel.Dock="Bottom" x:Name="UpdateResultsExpander" Header="Last update run" Margin="0,10,0,0" Visibility="Collapsed">
                        <TextBox x:Name="UpdateResultsText" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                                 MaxHeight="160" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="#FAFAFA" Padding="6"/>
                    </Expander>
                    <DataGrid x:Name="UpdatesGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended" ClipboardCopyMode="IncludeHeader"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E6E6E6"
                              Background="White" BorderBrush="#E0E0E0" RowHeaderWidth="0">
                                                <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy selected rows" Click="CopyRows_Click"/>
                                <MenuItem Header="Copy application name" Click="CopyColumn_Click" Tag="Name"/>
                                <MenuItem Header="Copy package ID" Click="CopyColumn_Click" Tag="Id"/>
                                <Separator/>
                                <MenuItem Header="Remove from manual updates list" Click="ClearManual_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Update" Width="62">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Tick to include in 'Install ticked'"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Exclude" Width="62">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Excluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanExclude}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Never update this app automatically (then Save exclusions)"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Application" Binding="{Binding Name}" IsReadOnly="True" Width="2*"/>
                            <DataGridTextColumn Header="Package ID" Binding="{Binding Id}" IsReadOnly="True" Width="2*"/>
                            <DataGridTextColumn Header="Installed" Binding="{Binding Installed}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Available" Binding="{Binding Available}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Note" Binding="{Binding Note}" IsReadOnly="True" Width="1.4*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="History" x:Name="HistoryTab">
                <DockPanel Margin="10">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Every app update and fix PatchSentinel has made on this device. Right-click to copy, or export for your records."/>
                    <StackPanel DockPanel.Dock="Top" x:Name="ManualPanel" Visibility="Collapsed" Margin="0,0,0,10">
                        <TextBlock Text="Needs a manual update" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,6"
                                   Text="Automatic updates of these apps failed repeatedly, so scheduled runs skip them. Update them with the vendor's installer (or tick them on App updates to retry); they leave this list once they are up to date."/>
                        <DataGrid x:Name="ManualGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="150"
                                  ClipboardCopyMode="IncludeHeader" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E6E6E6"
                                  Background="White" BorderBrush="#E0E0E0" RowHeaderWidth="0" SelectionMode="Extended">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy selected rows" Click="CopyRows_Click"/>
                                    <MenuItem Header="Copy application name" Click="CopyColumn_Click" Tag="Name"/>
                                    <MenuItem Header="Copy package ID" Click="CopyColumn_Click" Tag="Id"/>
                                    <MenuItem Header="Copy last error" Click="CopyColumn_Click" Tag="LastError"/>
                                    <Separator/>
                                    <MenuItem Header="Remove from manual updates list" Click="ClearManual_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Application" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="Package ID" Binding="{Binding Id}" Width="2*"/>
                                <DataGridTextColumn Header="Installed" Binding="{Binding InstalledVersion}" Width="*"/>
                                <DataGridTextColumn Header="Available" Binding="{Binding AvailableVersion}" Width="*"/>
                                <DataGridTextColumn Header="Failures" Binding="{Binding Failures}" Width="60"/>
                                <DataGridTextColumn Header="Last error" Binding="{Binding LastError}" Width="3*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button Content="Refresh" Click="RefreshHistory_Click"/>
                        <Button Content="Export history (CSV)..." Click="ExportHistory_Click"/>
                    </WrapPanel>
                    <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              ClipboardCopyMode="IncludeHeader" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E6E6E6"
                              Background="White" BorderBrush="#E0E0E0" RowHeaderWidth="0" SelectionMode="Extended">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy selected rows" Click="CopyRows_Click"/>
                                <MenuItem Header="Copy name" Click="CopyColumn_Click" Tag="Name"/>
                                <MenuItem Header="Copy details" Click="CopyColumn_Click" Tag="Message"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When" Binding="{Binding When}" Width="120"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="80"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="From" Binding="{Binding From}" Width="*"/>
                            <DataGridTextColumn Header="To" Binding="{Binding To}" Width="*"/>
                            <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="70"/>
                            <DataGridTextColumn Header="Details" Binding="{Binding Message}" Width="3*"/>
                            <DataGridTextColumn Header="Started by" Binding="{Binding Trigger}" Width="1.2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Schedule" x:Name="ScheduleTab">
                <StackPanel Margin="20" MaxWidth="620" HorizontalAlignment="Left">
                    <TextBlock x:Name="ScheduleLockText" Foreground="{StaticResource Warning}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Visibility="Collapsed" Text="Your IT administrator manages this schedule, so it cannot be changed here."/>
                    <CheckBox x:Name="ScheduleEnabled" Content="Install app updates automatically on a schedule" Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="How often" Width="190" VerticalAlignment="Center"/>
                        <ComboBox x:Name="FrequencyBox" Width="160" SelectionChanged="Frequency_Changed">
                            <ComboBoxItem Content="Daily"/>
                            <ComboBoxItem Content="Weekly"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel x:Name="DaysPanel" Orientation="Horizontal" Margin="190,0,0,12">
                        <CheckBox x:Name="DayMon" Content="Mon" Margin="0,0,10,0"/>
                        <CheckBox x:Name="DayTue" Content="Tue" Margin="0,0,10,0"/>
                        <CheckBox x:Name="DayWed" Content="Wed" Margin="0,0,10,0"/>
                        <CheckBox x:Name="DayThu" Content="Thu" Margin="0,0,10,0"/>
                        <CheckBox x:Name="DayFri" Content="Fri" Margin="0,0,10,0"/>
                        <CheckBox x:Name="DaySat" Content="Sat" Margin="0,0,10,0"/>
                        <CheckBox x:Name="DaySun" Content="Sun"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Time (24-hour, HH:mm)" Width="190" VerticalAlignment="Center"/>
                        <TextBox x:Name="TimeBox" Width="80" Padding="3"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Remind me this many minutes before" Width="190" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <TextBox x:Name="NotifyBox" Width="80" Padding="3"/>
                    </StackPanel>
                    <CheckBox x:Name="RunIfMissedBox" Content="If the PC was off at that time, install shortly after it next starts" Margin="0,0,0,16"/>
                    <Button x:Name="SaveScheduleButton" Content="Save schedule" Click="SaveSchedule_Click" HorizontalAlignment="Left" Style="{StaticResource Primary}"/>
                    <TextBlock x:Name="ScheduleResultText" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
