<Window x:Class="PatchSentinel.Tray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PatchSentinel" Height="660" Width="1080" MinHeight="500" MinWidth="860"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13" Background="#F7F7F7">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#ECECEC" Padding="12,5">
            <TextBlock x:Name="StatusBarText" Text="Connecting to the PatchSentinel agent..." Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
        </Border>

        <TabControl x:Name="Tabs" Margin="10" Background="White">
            <TabItem Header="Overview" x:Name="OverviewTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock x:Name="HeadlineText" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Text="Checking this device..."/>
                        <TextBlock x:Name="SubheadText" Margin="0,6,0,18" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                        <UniformGrid Columns="4" Margin="0,0,0,18">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="EolCount" Style="{StaticResource CardNumber}" Foreground="{StaticResource Critical}" Text="-"/>
                                    <TextBlock Text="End-of-life software" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="NearingCount" Style="{StaticResource CardNumber}" Foreground="{StaticResource Warning}" Text="-"/>
                                    <TextBlock Text="Approaching end of life" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="OutdatedCount" Style="{StaticResource CardNumber}" Foreground="{StaticResource Warning}" Text="-"/>
                                    <TextBlock Text="Runtimes missing patches" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="UpdatesCount" Style="{StaticResource CardNumber}" Foreground="{StaticResource Accent}" Text="-"/>
                                    <TextBlock Text="App updates available" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <TextBlock x:Name="ScheduleSummaryText" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <WrapPanel>
                            <Button x:Name="ScanButton" Content="Scan now" Click="ScanNow_Click" Style="{StaticResource Primary}"/>
                            <Button x:Name="UpdateAllButton" Content="Install app updates now" Click="UpdateAll_Click"/>
                            <Button x:Name="DeferButton" Content="Postpone scheduled updates 1 hour" Click="Defer_Click"/>
                            <Button x:Name="ExportButton" Content="Export report..." Click="Export_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="WarningsText" Margin="0,14,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Legacy &amp; end-of-life" x:Name="FindingsTab">
                <DockPanel Margin="10">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="This software no longer gets security fixes (or is missing patches) and will be reported by vulnerability scans. Select Fix to see which apps still use it and the safest way to remove or upgrade it."/>
                    <DataGrid x:Name="FindingsGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              CanUserAddRows="False" SelectionMode="Single" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E6E6E6" Background="White" BorderBrush="#E0E0E0" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="80"/>
                            <DataGridTextColumn Header="Software" Binding="{Binding Title}" Width="2*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="2*"/>
                            <DataGridTextColumn Header="Installed" Binding="{Binding Versions}" Width="1.6*"/>
                            <DataGridTextColumn Header="Apps using it" Binding="{Binding Dependents}" Width="1.2*"/>
                            <DataGridTemplateColumn Header="" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Fix..." Click="Fix_Click" Tag="{Binding}" Margin="4,3" Padding="10,2" MinWidth="0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="App updates" x:Name="UpdatesTab">
                <DockPanel Margin="10">
                    <TextBlock DockPanel.Dock="Top" x:Name="UpdatesIntro" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Updates found by winget. Tick Exclude for apps that must not be updated automatically, then Save exclusions."/>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button Content="Check for updates" Click="ScanNow_Click"/>
                        <Button x:Name="InstallSelectedButton" Content="Install selected" Click="InstallSelected_Click"/>
                        <Button Content="Install all (except excluded)" Click="UpdateAll_Click" Style="{StaticResource Primary}"/>
                        <Button x:Name="SaveExclusionsButton" Content="Save exclusions" Click="SaveExclusions_Click"/>
                        <Button x:Name="UserUpdatesButton" Content="Update my per-user apps" Click="UserUpdates_Click"
                                ToolTip="Runs winget in your own account for apps installed only for you"/>
                    </WrapPanel>
                    <DataGrid x:Name="UpdatesGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E6E6E6"
                              Background="White" BorderBrush="#E0E0E0" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Exclude" Binding="{Binding Excluded, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                            <DataGridTextColumn Header="Application" Binding="{Binding Name}" IsReadOnly="True" Width="2*"/>
                            <DataGridTextColumn Header="Package ID" Binding="{Binding Id}" IsReadOnly="True" Width="2*"/>
                            <DataGridTextColumn Header="Installed" Binding="{Binding Installed}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Available" Binding="{Binding Available}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Note" Binding="{Binding Note}" IsReadOnly="True" Width="1.4*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Schedule" x:Name="ScheduleTab">
                <StackPanel Margin="20" MaxWidth="620" HorizontalAlignment="Left">
                    <TextBlock x:Name="ScheduleLockText" Foreground="{StaticResource Warning}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Visibility="Collapsed" Text="Your IT administrator manages this schedule, so it cannot be changed here."/>
                    <CheckBox x:Name="ScheduleEnabled" Content="Install app updates automatically on a schedule" Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="How often" Width="190" VerticalAlignment="Center"/>
                        <ComboBox x:Name="FrequencyBox" Width="160" SelectionChanged="Frequency_Changed">
                            <ComboBoxItem Content="Daily"/>
                            <ComboBoxItem Content="Weekly"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel x:Name="DaysPanel" Orientation="Horizontal" Margin="190,0,0,12">
                        <CheckBox x:Name="DayMon" Content="Mon" Margin="0,0,10,0"/>
                        <CheckBox x:Name="DayTue" Content="Tue" Margin="0,0,10,0"/>
                        <CheckBox x:Name="DayWed" Content="Wed" Margin="0,0,10,0"/>
                        <CheckBox x:Name="DayThu" Content="Thu" Margin="0,0,10,0"/>
                        <CheckBox x:Name="DayFri" Content="Fri" Margin="0,0,10,0"/>
                        <CheckBox x:Name="DaySat" Content="Sat" Margin="0,0,10,0"/>
                        <CheckBox x:Name="DaySun" Content="Sun"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Time (24-hour, HH:mm)" Width="190" VerticalAlignment="Center"/>
                        <TextBox x:Name="TimeBox" Width="80" Padding="3"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Remind me this many minutes before" Width="190" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <TextBox x:Name="NotifyBox" Width="80" Padding="3"/>
                    </StackPanel>
                    <CheckBox x:Name="RunIfMissedBox" Content="If the PC was off at that time, install shortly after it next starts" Margin="0,0,0,16"/>
                    <Button x:Name="SaveScheduleButton" Content="Save schedule" Click="SaveSchedule_Click" HorizontalAlignment="Left" Style="{StaticResource Primary}"/>
                    <TextBlock x:Name="ScheduleResultText" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
