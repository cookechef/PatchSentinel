<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF and WinForms both define Application/MessageBox etc., so usings are explicit. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>PatchSentinel.Tray</AssemblyName>
    <RootNamespace>PatchSentinel.Tray</RootNamespace>
    <ApplicationIcon>..\..\assets\patchsentinel.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF0001: Application.ThemeMode (Fluent light/dark theme) is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PatchSentinel.Core\PatchSentinel.Core.csproj" />
  </ItemGroup>

</Project>
